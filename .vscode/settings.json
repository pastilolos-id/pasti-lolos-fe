{
  "files.eol": "\n",

  // Jadikan Biome sebagai formatter utama
  "editor.defaultFormatter": "biomejs.biome",

  // Auto format
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,

  // Pastikan editor pakai 2 spasi (fallback)
  "editor.tabSize": 2,
  "editor.insertSpaces": true,

  // Biome actions
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit",
    "source.fixAll.biome": "explicit"
  },

  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "biomejs.biome"
  },

  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },

  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[scss]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[less]": {
    "editor.defaultFormatter": "biomejs.biome"
  },

  "[html]": {
    "editor.defaultFormatter": "biomejs.biome"
  },

  "[markdown]": {
    "editor.defaultFormatter": "biomejs.biome"
  },

  "[yaml]": {
    "editor.defaultFormatter": "biomejs.biome"
  },

  // Jangan biarkan formatter lain ikut campur
  "eslint.enable": false,
  "prettier.enable": false
}
